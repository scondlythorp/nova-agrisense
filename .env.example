# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Nova AgriSense — FastAPI Backend Configuration (apps/api)
# -----------------------------------------------------------------------------
NOVA_ENV="development"
NOVA_APP_NAME="Nova AgriSense API"
NOVA_API_V1_PREFIX="/api/v1"
NOVA_LOG_LEVEL="INFO"

# PostgreSQL / Cloud SQL Connection (never commit real credentials)
# Runtime application user (NOBYPASSRLS) for API execution:
NOVA_DATABASE_URL="postgresql+psycopg://nova_app_user:CHANGE_ME@localhost:5432/nova_agrisense"
# Optional dedicated test database URL for Pytest:
# NOVA_TEST_DATABASE_URL="postgresql+psycopg://nova_app_user:CHANGE_ME@localhost:5432/nova_agrisense_test"
NOVA_DB_POOL_SIZE="5"
NOVA_DB_MAX_OVERFLOW="10"
NOVA_DB_ECHO="false"

# Security & Authentication (generate strong 32+ byte random secret for staging/prod)
NOVA_SECRET_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
NOVA_JWT_ALGORITHM="HS256"
NOVA_JWT_ISSUER="nova-agrisense-api"
NOVA_JWT_AUDIENCE="nova-agrisense-clients"
NOVA_ACCESS_TOKEN_EXPIRE_MINUTES="15"
NOVA_REFRESH_TOKEN_EXPIRE_DAYS="14"
NOVA_ALLOW_SELF_REGISTRATION="true"
NOVA_REQUIRE_EMAIL_VERIFICATION="false"

# HttpOnly Refresh & CSRF Cookies
NOVA_REFRESH_COOKIE_NAME="nova_refresh_token"
NOVA_CSRF_COOKIE_NAME="nova_csrf_token"
NOVA_COOKIE_SAMESITE="lax"
# NOVA_COOKIE_SECURE="true" # Automatically true in staging/production
# NOVA_COOKIE_DOMAIN=""

# Auth Rate Limiting & Proxy Trust
NOVA_TRUST_PROXY_HEADERS="false"
NOVA_AUTH_RATE_LIMIT_MAX_ATTEMPTS="10"
NOVA_AUTH_RATE_LIMIT_WINDOW_SECONDS="60"

# Strict CORS Origins (JSON array or comma-separated list)
NOVA_CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Google Cloud Storage & External Providers (Phase 5+)
NOVA_GCS_BUCKET_NAME=""
NOVA_WEATHER_PROVIDER="unconfigured"
NOVA_WEATHER_API_KEY=""

# -----------------------------------------------------------------------------
# Nova AgriSense — Next.js Frontend Configuration (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="Nova AgriSense"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
